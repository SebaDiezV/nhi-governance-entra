@"
# Audit logs (may contain sensitive NHI data - GDPR)
*.log
logs/

# Credentials - never commit
*.pfx
*.key
*.p12
secrets.ps1
config.local.ps1

# VS Code
.vscode/settings.json

# PowerShell temp
*.ps1xml
"@ | Set-Content .gitignore

echo "*.log" >> .gitignore
echo "logs/*.log" >> .gitignore
echo "*.csv" >> .gitignore